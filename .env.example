# Root development defaults. Copy values into app-specific .env files if needed.

# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/observability
CORS_ORIGINS=http://localhost:5173,https://YOUR_GITHUB_USERNAME.github.io,https://YOUR_GITHUB_USERNAME.github.io/ai-agent-observability-dashboard
ENVIRONMENT=development
DEMO_MODE=true
PORT=8000

# Frontend (Vite exposes only VITE_* values to the browser)
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=true
VITE_REPO_URL=https://github.com/YOUR_USERNAME/ai-agent-observability-dashboard
